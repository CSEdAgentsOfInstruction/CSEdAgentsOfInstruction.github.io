{
  "name": "agents-of-instruction-python-course",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate": "node scripts/validate-content.mjs",
    "validate:snapshot": "node scripts/validate-content.mjs --snapshot",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:grading": "node scripts/test-grading.mjs",
    "test:grading:snapshot": "node scripts/test-grading.mjs --snapshot",
    "test:browser": "playwright test",
    "test:distribution": "node scripts/test-distribution.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "marked": "18.2.0",
    "pyodide": "314.0.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
